+void sonic_enqueue_history(FrontendPresentation& p, unsigned windows,
+                           uint64_t deadline, uint64_t interval, bool blends,
+                           bool blend_secondary, PresentationTicks& ticks) {
+    // Allow emulation to refill the queue as soon as a frame is ready.
+    // Pace the producer by the actual queue depth, without a second timer.
+    p.history_blend_secondary = blend_secondary;
+    if (p.history_due_ns) {
+        while (p.history[0].following >= 0 &&
+               sonic_service_history(p, UINT64_MAX, true, ticks)) {}
+    }
+
+    for (int window = 0; window < 2; ++window) {
+        if (!(windows & (1u << window))) continue;
+        auto& history = p.history[window];
+        if (history.shown < 0) history.shown = history.write;
+        else if (history.queued < 0) history.queued = history.write;
+        else history.following = history.write;
+        history.write = 0;
+        while (history.write == history.shown || history.write == history.queued ||
+               history.write == history.following)
+            ++history.write;
+    }
+    if (!p.history_due_ns) {
+        // Keep two completed frames ahead before starting the display clock.
+        // A late producer frame usually spends that runway instead of
+        // repeating a displayed image.
+        if (p.history[0].following < 0) return;
+        const uint64_t start = SDL_GetPerformanceCounter();
+        for (int window = 0; window < 2; ++window) {
+            if (windows & (1u << window))
+                sonic_draw_history(p, window, p.history[window].shown);
+        }
+        ticks.draw += SDL_GetPerformanceCounter() - start;
+        const uint64_t swap = SDL_GetPerformanceCounter();
+        const uint64_t submitted = SDL_GetTicksNS();
+        for (int window = 0; window < 2; ++window) {
+            if (!(windows & (1u << window))) continue;
+            if (sonic_present(p.renderers[window], window, deadline, SonicPresentType::Native) && !window)
+                ++ticks.native_presents;
+        }
+        ticks.swap += SDL_GetPerformanceCounter() - swap;
+        p.history_interval_ns = interval;
+        p.history_due_ns = submitted + interval;
+        p.history_blends = blends;
+        p.history_blend_next = blends;
+    } else {
+        sonic_service_history(p, SDL_GetTicksNS(), false, ticks);
+    }
+}
