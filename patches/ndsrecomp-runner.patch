+void sonic_sample_motion(SonicMotionRegion& region, const SonicScreenRect& rect,
+                         const uint32_t* pixels, int width) {
+    region.rect = rect;
+    if (!rect.w || !rect.h) return;
+    constexpr int step = 4;
+    size_t i = 0;
+    for (int row = 0; row < SonicMotionRegion::rows; ++row) {
+        for (int col = 0; col < SonicMotionRegion::columns; ++col) {
+            for (int y = 0; y < step; ++y) {
+                const int py = (2 * (row * step + y) + 1) * kScreenHeight /
+                               (2 * SonicMotionRegion::rows * step);
+                for (int x = 0; x < step; ++x) {
+                    const int px = (2 * (col * step + x) + 1) * width /
+                                   (2 * SonicMotionRegion::columns * step);
+                    region.pixels[i++] = pixels[py * width + px];
+                }
+            }
+        }
+    }
+}
+
+#if defined(NDS_HAVE_SDL3)
+bool sonic_blend_regions(SDL_Renderer* renderer, SDL_Texture* next,
+                         const SonicWindowFrameHistory& history, int frame, int blend) {
+    constexpr int cols = SonicMotionRegion::columns;
+    constexpr int rows = SonicMotionRegion::rows;
+    constexpr int samples = SonicMotionRegion::samples;
+    constexpr SDL_FColor alpha{1.f, 1.f, 1.f, 0.5f};
+    std::array<SDL_Vertex, 2 * rows * ((cols + 1) / 2) * 6> vertices;
+    size_t count = 0;
+    for (int region = 0; region < 2; ++region) {
+        const auto& old_image = history.motion[frame][region];
+        const auto& new_image = history.motion[blend][region];
+        const auto& a = old_image.rect;
+        const auto& b = new_image.rect;
+        if (!a.w || !b.w || a.x != b.x || a.y != b.y || a.w != b.w || a.h != b.h)
+            continue;
+        for (int row = 0; row < rows; ++row) {
+            auto stable = [&](int col) {
+                int changed = 0;
+                const size_t start = (row * cols + col) * samples;
+                for (int k = 0; k < samples; ++k) {
+                    const uint32_t old_pixel = old_image.pixels[start + k];
+                    const uint32_t new_pixel = new_image.pixels[start + k];
+                    int difference = 0;
+                    for (int shift = 0; shift <= 16; shift += 8)
+                        difference += std::abs(int((old_pixel >> shift) & 255u) -
+                                               int((new_pixel >> shift) & 255u));
+                    if (difference >= 72 && ++changed >= 2) return false;
+                }
+                return true;
+            };
+            for (int col = 0; col < cols;) {
+                if (!stable(col)) {
+                    ++col;
+                    continue;
+                }
+                const int run = col++;
+                while (col < cols && stable(col)) ++col;
+                float x0 = a.x + float(run * a.w) / cols;
+                float x1 = a.x + float(col * a.w) / cols;
+                float y0 = a.y + float(row * a.h) / rows;
+                float y1 = a.y + float((row + 1) * a.h) / rows;
+                auto corner = [&](float x, float y) {
+                    return SDL_Vertex{{x, y}, alpha, {x / history.geometry[2], y / history.geometry[3]}};
+                };
+                const auto tl = corner(x0, y0);
+                const auto tr = corner(x1, y0);
+                const auto bl = corner(x0, y1);
+                const auto br = corner(x1, y1);
+                vertices[count++] = tl; vertices[count++] = tr; vertices[count++] = bl;
+                vertices[count++] = tr; vertices[count++] = br; vertices[count++] = bl;
+            }
+        }
+    }
+    if (!count) return false;
+    SDL_SetTextureBlendMode(next, SDL_BLENDMODE_BLEND);
+    const bool drawn = SDL_RenderGeometry(renderer, next, vertices.data(),
+                                          static_cast<int>(count), nullptr, 0);
+    SDL_SetTextureBlendMode(next, SDL_BLENDMODE_NONE);
+    return drawn;
+}
+#endif
+
+bool sonic_draw_history(FrontendPresentation& p, int window, int frame, int blend = -1) {
+    auto* renderer = p.renderers[window];
+    const auto& history = p.history[window];
+    const SDL_Rect rect{0, 0, history.geometry[2], history.geometry[3]};
+    const uint8_t background = g_sonic_pc.border == 1 ? 0 : 20;
+    SDL_SetRenderDrawColor(renderer, background, background, background, 255);
+    SDL_RenderClear(renderer);
+    render_texture(renderer, history.images[frame], &rect);
+    if (blend >= 0) {
+        auto* next = history.images[blend];
+#if defined(NDS_HAVE_SDL3)
+        if (g_sonic_pc.internal_resolution)
+            return sonic_blend_regions(renderer, next, history, frame, blend);
+#endif
+        SDL_SetTextureAlphaMod(next, 128);
+        SDL_SetTextureBlendMode(next, SDL_BLENDMODE_BLEND);
+        render_texture(renderer, next, &rect);
+        SDL_SetTextureAlphaMod(next, 255);
+        SDL_SetTextureBlendMode(next, SDL_BLENDMODE_NONE);
+    }
+    return blend >= 0;
+}
