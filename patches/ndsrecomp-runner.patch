+// Submit either display phase using only completed textures. A slow guest
+// frame can leave no new image for a slot, so hold the last complete image.
+bool sonic_service_history(FrontendPresentation& p, uint64_t cutoff_ns,
+                           bool wait, PresentationTicks& ticks) {
+    const uint64_t due = p.history_due_ns;
+    if (!due || due > cutoff_ns || p.history[0].shown < 0) return false;
+    if (!wait && SDL_GetTicksNS() < due) return false;
+    const uint64_t draw_start = SDL_GetPerformanceCounter();
+    auto type = SonicPresentType::Repeated;
+    unsigned windows = 0;
+    const int count = p.separate && (!p.history_blend_next || p.history_blend_secondary) ? 2 : 1;
+    for (int window = 0; window < count; ++window) {
+        auto& history = p.history[window];
+        if (history.shown < 0) continue;
+        auto window_type = SonicPresentType::Repeated;
+        int blend = -1;
+        if (history.queued >= 0) {
+            if (p.history_blend_next) {
+                blend = history.queued;
+                history.queued_blended = true;
+                window_type = SonicPresentType::Blended;
+            } else if (!p.history_blends || history.queued_blended ||
+                       (window && !p.history_blend_secondary)) {
+                // If the producer missed the previous midpoint, preserve the
+                // pair for the next one instead of repeatedly outrunning it.
+                history.shown = history.queued;
+                history.queued = history.following;
+                history.following = -1;
+                history.queued_blended = false;
+                window_type = SonicPresentType::Native;
+            }
+        }
+        const bool blended = sonic_draw_history(p, window, history.shown, blend);
+        if (blend >= 0 && !blended) window_type = SonicPresentType::Repeated;
+        if (!window) type = window_type;
+        windows |= 1u << window;
+    }
+    ticks.draw += SDL_GetPerformanceCounter() - draw_start;
+    wait_for_presentation(due);
+    const uint64_t swap_start = SDL_GetPerformanceCounter();
+    const uint64_t submitted = SDL_GetTicksNS();
+    for (int window = 0; window < count; ++window) {
+        if (!(windows & (1u << window))) continue;
+        if (sonic_present(p.renderers[window], window, due, type) && !window) {
+            switch (type) {
+            case SonicPresentType::Native: ++ticks.native_presents; break;
+            case SonicPresentType::Blended: ++ticks.blended_presents; break;
+            case SonicPresentType::Repeated: ++ticks.repeated_presents; break;
+            }
+        }
+    }
+    ticks.swap += SDL_GetPerformanceCounter() - swap_start;
+    // Preserve the cadence after a small overrun, without issuing a catch-up burst.
+    p.history_due_ns = std::max(due + p.history_interval_ns,
+                                submitted + p.history_interval_ns * 9 / 10);
+    p.history_blend_next = p.history_blends && !p.history_blend_next;
+#if defined(NDS_HAVE_COMPUTE_RENDERER)
+    nds_compute_host_make_current();
+#endif
+    return true;
+}
