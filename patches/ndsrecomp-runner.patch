+bool sonic_begin_history(FrontendPresentation& p, int window,
+                         const SonicScreenLayout& layout) {
+#if defined(NDS_HAVE_SDL3)
+    auto* renderer = p.renderers[window];
+    auto& history = p.history[window];
+    SDL_FRect viewport{};
+    if (!SDL_GetRenderLogicalPresentationRect(renderer, &viewport) ||
+        viewport.w < 1 || viewport.h < 1) {
+        history.reset();
+        return false;
+    }
+    const int width = static_cast<int>(std::ceil(viewport.w));
+    const int height = static_cast<int>(std::ceil(viewport.h));
+    const std::array geometry{width, height, layout.width, layout.height};
+    if (history.geometry != geometry) {
+        if (history.geometry[0] != width || history.geometry[1] != height) {
+            history.clear();
+            for (auto*& image : history.images) {
+                image = SDL_CreateTexture(renderer, SDL_PIXELFORMAT_ARGB8888,
+                                          SDL_TEXTUREACCESS_TARGET, width, height);
+                if (!image) {
+                    history.clear();
+                    return false;
+                }
+                SDL_SetTextureScaleMode(image, SDL_SCALEMODE_NEAREST);
+                SDL_SetTextureBlendMode(image, SDL_BLENDMODE_NONE);
+            }
+        }
+        history.geometry = geometry;
+        history.reset();
+    }
+    if (SDL_SetRenderTarget(renderer, history.images[history.write]) &&
+        set_render_logical_size(renderer, layout.width, layout.height, true))
+        return true;
+    SDL_SetRenderTarget(renderer, nullptr);
+    history.reset();
+#else
+    (void)p;
+    (void)window;
+    (void)layout;
+#endif
+    return false;
+}
