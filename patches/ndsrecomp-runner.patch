+
+bool nds_compute_host_wait_on_fence(void* sync)
+{
+    if (!sync) return false;
+    const auto fence = static_cast<GLsync>(sync);
+    GLenum status;
+    if (!g_wait_pump) {
+        status = glClientWaitSync(fence, 0, 5000000000ull);
+    } else {
+        using Clock = std::chrono::steady_clock;
+        const auto deadline = Clock::now() + std::chrono::seconds(5);
+        do {
+            status = glClientWaitSync(fence, 0, 250000ull);
+            if (status != GL_TIMEOUT_EXPIRED) break;
+            g_wait_pump(g_wait_context);
+        } while (Clock::now() < deadline);
+    }
+    return status == GL_ALREADY_SIGNALED || status == GL_CONDITION_SATISFIED;
+}
