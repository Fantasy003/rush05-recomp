+struct SonicDisplayWaitPump {
+    explicit SonicDisplayWaitPump(FrontendPresentation& presentation) : presentation(presentation) {
+#if defined(NDS_HAVE_COMPUTE_RENDERER)
+        if (presentation.history_due_ns)
+            nds_compute_host_set_wait_pump(pump, this);
+#endif
+    }
+    ~SonicDisplayWaitPump() {
+#if defined(NDS_HAVE_COMPUTE_RENDERER)
+        nds_compute_host_set_wait_pump(nullptr, nullptr);
+#endif
+    }
+    static void pump(void* context) {
+        auto& state = *static_cast<SonicDisplayWaitPump*>(context);
+        constexpr uint64_t draw_ahead_ns = 750000;
+        const uint64_t cutoff = SDL_GetTicksNS() + draw_ahead_ns;
+        if (!state.presentation.history_due_ns || cutoff < state.presentation.history_due_ns) return;
+        const uint64_t start = SDL_GetPerformanceCounter();
+        if (sonic_service_history(state.presentation, cutoff, true, state.ticks))
+            state.elapsed += SDL_GetPerformanceCounter() - start;
+    }
+    FrontendPresentation& presentation;
+    PresentationTicks ticks{};
+    uint64_t elapsed = 0;
+};
