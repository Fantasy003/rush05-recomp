+    std::fputs("deadline_ns,submit_start_ns,submit_end_ns,type\n", file);
+    const size_t count = std::min(sonic_present_sample_count, sonic_present_samples.size());
+    for (size_t i = sonic_present_sample_count - count; i < sonic_present_sample_count; ++i) {
+        const auto& sample = sonic_present_samples[i % sonic_present_samples.size()];
+        std::fprintf(file, "%llu,%llu,%llu,%d\n",
