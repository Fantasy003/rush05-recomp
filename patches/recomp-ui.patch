 int recomp_runtime_ui_wants_text_input(const RecompRuntimeUi *ui) {
     return (ui && ui->open && ui->editing_text) ? 1 : 0;
+}
+
+int recomp_runtime_ui_insert_text(RecompRuntimeUi *ui, const char *text) {
+    if (!recomp_runtime_ui_wants_text_input(ui) || !text || !*text) return 0;
+    const RecompRuntimeUiItem *item = recomp_runtime_ui_section_item(
+        ui, ui->section_index, ui->row_index);
+    if (!item || item->type != RECOMP_RUNTIME_UI_TEXT) return 0;
+    size_t limit = sizeof(ui->edit_buffer) - 1;
+    if (item->maximum > 0 && (size_t)item->maximum < limit)
+        limit = (size_t)item->maximum;
+    const size_t offset = ui->edit_select_all ? 0 : strlen(ui->edit_buffer);
+    const size_t size = strlen(text);
+    if (offset > limit || size > limit - offset) return 0;
+    for (size_t i = 0; i < size; ++i)
+        if ((unsigned char)text[i] < 32 || (unsigned char)text[i] > 126) return 0;
+    memcpy(ui->edit_buffer + offset, text, size + 1);
+    ui->edit_select_all = 0;
+    return 1;
+}
+
+void recomp_runtime_ui_edit_text(RecompRuntimeUi *ui, RecompRuntimeUiTextEdit edit) {
+    if (!recomp_runtime_ui_wants_text_input(ui)) return;
+    if (edit == RECOMP_RUNTIME_UI_TEXT_CANCEL) {
+        ui->editing_text = 0;
+    } else if (edit == RECOMP_RUNTIME_UI_TEXT_SELECT_ALL) {
+        ui->edit_select_all = 1;
+    } else if (edit == RECOMP_RUNTIME_UI_TEXT_BACKSPACE) {
+        size_t size = ui->edit_select_all ? 0 : strlen(ui->edit_buffer);
+        if (size) {
+            --size;
+            while (size && ((unsigned char)ui->edit_buffer[size] & 0xC0) == 0x80)
+                --size;
+        }
+        ui->edit_buffer[size] = 0;
+        ui->edit_select_all = 0;
+    } else if (edit == RECOMP_RUNTIME_UI_TEXT_CONFIRM) {
+        const RecompRuntimeUiItem *item = recomp_runtime_ui_section_item(
+            ui, ui->section_index, ui->row_index);
+        if (recomp_runtime_ui_commit_text(ui, item, ui->edit_buffer))
+            ui->editing_text = 0;
+    }
 }
 
